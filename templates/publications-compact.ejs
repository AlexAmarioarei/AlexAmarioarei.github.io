```{=html}
<%
// Short list for the homepage: year, title, venue.
// Language comes from `template-params: {lang: en}` in the page YAML (default: Romanian)
const en = typeof templateParams !== "undefined" && templateParams && templateParams.lang === "en";
%>
<ol class="pub-compact list-unstyled">
<% for (const item of items) { %>
  <li class="pub">
    <span class="pub-year"><%- item.year %></span>
    <span class="pub-title"><%- item.title %></span>.
    <span class="pub-venue"><%- item.venue %></span>.
    <% if (item.doi) { %><a href="https://doi.org/<%- item.doi %>" class="ui small" aria-label="DOI: <%- item.title %>">DOI</a><% } %>
  </li>
<% } %>
</ol>
```
